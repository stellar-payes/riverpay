# Soroban RPC node used for read-only contract calls and event indexing.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Postgres connection string (see docker-compose.yml).
DATABASE_URL=postgres://riverpay:riverpay@localhost:5432/riverpay

# stream-core contract ID from `contracts/scripts/deploy.sh` output.
STREAM_CONTRACT_ID=

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
